<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="logica.Presentacion.ConsultaRegistroInternalFrame">
  <grid id="1" binding="panelPrincipal" layout-manager="GridLayoutManager" row-count="3" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="10">
    <margin top="10" left="10" bottom="10" right="10"/>
    <constraints><xy x="20" y="20" width="620" height="520"/></constraints>
    <properties/><border type="none"/>
    <children>
      <grid id="2" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="10">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints><grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/></constraints>
        <properties/><border type="none"/>
        <children>
          <scrollpane id="3">
            <constraints><grid row="0" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"><preferred-size width="560" height="140"/></grid></constraints>
            <properties/><border type="none"/>
            <children><component id="4" class="javax.swing.JTextArea" binding="txtListadoAsistentes"><constraints/><properties/></component></children>
          </scrollpane>
          <grid id="5" layout-manager="GridLayoutManager" row-count="1" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="10">
            <margin top="0" left="0" bottom="0" right="0"/>
            <constraints><grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints>
            <properties/><border type="none"/>
            <children>
              <component id="6" class="javax.swing.JLabel"><constraints><grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Nickname del asistente:"/></properties></component>
              <component id="7" class="javax.swing.JTextField" binding="txtNickname"><constraints><grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"><preferred-size width="180" height="-1"/></grid></constraints><properties/></component>
              <component id="8" class="javax.swing.JButton" binding="btnBuscarRegistros"><constraints><grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><text value="Buscar registros"/></properties></component>
            </children>
          </grid>
        </children>
      </grid>
      <grid id="9" binding="panelRegistros" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="10">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints><grid row="1" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/></constraints>
        <properties/><border type="none"/>
        <children>
          <scrollpane id="10"><constraints><grid row="0" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"><preferred-size width="560" height="120"/></grid></constraints><properties/><border type="none"/><children><component id="11" class="javax.swing.JTextArea" binding="txtListadoRegistros"><constraints/><properties/></component></children></scrollpane>
          <grid id="12" layout-manager="GridLayoutManager" row-count="1" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="10">
            <margin top="0" left="0" bottom="0" right="0"/>
            <constraints><grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints><properties/><border type="none"/>
            <children>
              <component id="13" class="javax.swing.JLabel"><constraints><grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Id del registro:"/></properties></component>
              <component id="14" class="javax.swing.JTextField" binding="txtIdRegistro"><constraints><grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"><preferred-size width="90" height="-1"/></grid></constraints><properties/></component>
              <component id="15" class="javax.swing.JButton" binding="btnVerDetalle"><constraints><grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><text value="Ver detalle"/></properties></component>
            </children>
          </grid>
        </children>
      </grid>
      <grid id="16" binding="panelDetalle" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="10">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints><grid row="2" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/></constraints>
        <properties/><border type="none"/>
        <children>
          <scrollpane id="17"><constraints><grid row="0" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"><preferred-size width="560" height="120"/></grid></constraints><properties/><border type="none"/><children><component id="18" class="javax.swing.JTextArea" binding="txtDetalleRegistro"><constraints/><properties/></component></children></scrollpane>
          <component id="19" class="javax.swing.JButton" binding="btnCerrar">
            <constraints><grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="4" fill="1" indent="0" use-parent-layout="false"/></constraints>
            <properties><text value="Cerrar"/></properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
