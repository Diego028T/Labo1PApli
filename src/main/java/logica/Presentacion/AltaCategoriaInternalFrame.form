<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="logica.Presentacion.AltaCategoriaInternalFrame">
  <grid id="27dc6" binding="principalPanel" layout-manager="GridLayoutManager" row-count="4" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="10">
    <margin top="10" left="10" bottom="10" right="10"/>
    <constraints>
      <xy x="20" y="20" width="450" height="350"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="e4f9d" class="javax.swing.JLabel" binding="lblTitulo">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Categorías existentes:"/>
        </properties>
      </component>
      <scrollpane id="e4fa6">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="2" vsize-policy="7" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <preferred-size width="250" height="150"/>
          </grid>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="e4fa7" class="javax.swing.JTree" binding="arbolCategorias">
            <constraints/>
            <properties>
              <rootVisible value="true"/>
              <showsRootHandles value="true"/>
            </properties>
          </component>
        </children>
      </scrollpane>
      <component id="e4fa1" class="javax.swing.JLabel" binding="lblNombre">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Nueva categoría:"/>
        </properties>
      </component>
      <component id="e4fa2" class="javax.swing.JTextField" binding="txtNombre">
        <constraints>
          <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
      </component>
      <component id="e4fa8" class="javax.swing.JButton" binding="btnAceptar">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Aceptar"/>
        </properties>
      </component>
      <component id="e4fa9" class="javax.swing.JButton" binding="btnCancelar">
        <constraints>
          <grid row="3" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Cancelar"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
