            <constraints><grid row="1" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"><preferred-size width="460" height="220"/></grid></constraints>
            <properties/><border type="none"/>
            <children><component id="5" class="javax.swing.JList" binding="listaEventos"><constraints/><properties/></component></children>
          </scrollpane>
