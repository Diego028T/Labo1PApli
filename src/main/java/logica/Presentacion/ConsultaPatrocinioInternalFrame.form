              <component id="28" class="javax.swing.JButton" binding="btnCerrarDetalles"><constraints><grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><text value="Cerrar"/></properties></component>
