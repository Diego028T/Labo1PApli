            <margin top="0" left="0" bottom="0" right="0"/>
            <constraints><grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints>
            <properties/><border type="none"/>
            <children>
              <component id="7" class="javax.swing.JButton" binding="btnSeleccionarEvento"><constraints><grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><text value="Seleccionar evento"/></properties></component>
              <component id="8" class="javax.swing.JButton" binding="btnCerrarEventos"><constraints><grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><text value="Cerrar"/></properties></component>
            </children>
          </grid>
        </children>
      </grid>
      <grid id="9" binding="panelEdiciones" layout-manager="GridLayoutManager" row-count="3" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="10">
