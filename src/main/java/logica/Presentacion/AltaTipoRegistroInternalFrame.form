<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="logica.Presentacion.AltaTipoRegistroInternalFrame">
  <grid id="1" binding="principalPanel" layout-manager="GridLayoutManager" row-count="6" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="8" vgap="8">
    <margin top="10" left="10" bottom="10" right="10"/>
    <constraints><xy x="20" y="20" width="500" height="300"/></constraints>
    <border type="none"/>
    <children>
      <component id="1" class="javax.swing.JLabel" binding="lblEdicion">
        <constraints><grid row="0" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints>
        <properties><text value="Tipos de registro"/></properties>
      </component>
      <component id="2" class="javax.swing.JLabel"><constraints><grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Nombre"/></properties></component>
      <component id="3" class="javax.swing.JTextField" binding="txtNombre"><constraints><grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints><properties/></component>
      <component id="4" class="javax.swing.JLabel"><constraints><grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Descripcion"/></properties></component>
      <component id="5" class="javax.swing.JTextField" binding="txtDescripcion"><constraints><grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints><properties/></component>
      <component id="6" class="javax.swing.JLabel"><constraints><grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Costo"/></properties></component>
      <component id="7" class="javax.swing.JTextField" binding="txtCosto"><constraints><grid row="3" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints><properties/></component>
      <component id="8" class="javax.swing.JLabel"><constraints><grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Cupo / Cantidad de cupos"/></properties></component>
      <component id="9" class="javax.swing.JPanel" binding="panelCupos"><constraints><grid row="4" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints><properties/></component>
      <component id="10" class="javax.swing.JButton" binding="btnGuardar"><constraints><grid row="5" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><text value="Guardar"/></properties></component>
      <component id="11" class="javax.swing.JButton" binding="btnLimpiar"><constraints><grid row="5" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><text value="Limpiar"/></properties></component>
    </children>
  </grid>
</form>
