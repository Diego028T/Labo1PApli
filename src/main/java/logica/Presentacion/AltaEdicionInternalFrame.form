<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="logica.Presentacion.AltaEdicionInternalFrame">
  <grid id="27dc6" binding="eventosListados" layout-manager="GridLayoutManager" row-count="5" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="722" height="400"/>
    </constraints>
    <properties>
      <minimumSize width="100" height="80"/>
    </properties>
    <border type="none"/>
    <children>
      <component id="e4f9d" class="javax.swing.JLabel" binding="txtEventos">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="3" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Seleccione un evento y un organizador. Luego Apriete el boton &quot;Alta Edicion&quot;"/>
        </properties>
      </component>
      <component id="64180" class="javax.swing.JButton" binding="altaEdicionButton" default-binding="true">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="3" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Alta Edicion"/>
        </properties>
      </component>
      <component id="f4e2a" class="javax.swing.JPanel" binding="panelFormularioEdicion">
        <constraints>
          <grid row="4" column="0" row-span="1" col-span="3" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <visible value="false"/>
        </properties>
      </component>
      <component id="2d00f" class="javax.swing.JList" binding="listaOrganizadores">
        <constraints>
          <grid row="2" column="2" row-span="1" col-span="1" vsize-policy="6" hsize-policy="2" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <preferred-size width="150" height="50"/>
          </grid>
        </constraints>
        <properties/>
      </component>
      <vspacer id="91b2">
        <constraints>
          <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
        </constraints>
      </vspacer>
      <component id="91dc4" class="javax.swing.JList" binding="listaEventos">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="6" hsize-policy="2" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <preferred-size width="150" height="50"/>
          </grid>
        </constraints>
        <properties>
          <model/>
        </properties>
      </component>
      <component id="6a7bd" class="javax.swing.JLabel">
        <constraints>
          <grid row="1" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Organizadores"/>
        </properties>
      </component>
      <component id="c17d3" class="javax.swing.JLabel">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Eventos Disponibles"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
