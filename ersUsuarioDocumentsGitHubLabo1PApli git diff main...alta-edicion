[32m+[m[32m        if (sigla == null || sigla.isBlank()) {[m
[32m+[m[32m            throw new IllegalArgumentException("La sigla de la edición es obligatoria.");[m
[32m+[m[32m        }[m
[32m+[m[32m        if (ciudad == null || ciudad.isBlank() || pais == null || pais.isBlank()) {[m
